38243>>>                // If from parent, this is a constrained drill down
38243>>>                // If Row select does main-zoom we don't need this
38243>>>                WebSet pbRender of oDetailButton to False
38244>>>                Case Break
38245>>>
38245>>>            Case (NavigateData.eNavigateType = nfFromChild)
38248>>>                // If from child, this is a probably a parent lookup from a Zoom
38248>>>                Case Break
38249>>>
38249>>>            Case (NavigateData.eNavigateType = nfFromMain)
38252>>>                // If from main, this is a probably a main-file lookup from a Zoom
38252>>>                WebSet pbRender of oDetailButton to False
38253>>>                Case Break
38254>>>
38254>>>            Case Else // must be nfUndefined
38254>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38254>>>                // If Row select does main-zoom we don't need this
38254>>>                WebSet pbRender of oDetailButton to False
38255>>>
38255>>>        Case End
