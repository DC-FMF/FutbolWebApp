37529>>>>>        WebSet pbRender of oEditBtn to False
37530>>>>>        WebSet pbRender of oSaveBtn to False
37531>>>>>        WebSet pbRender of oCancelChangesBtn to False
37532>>>>>        WebSet pbRender of oDeleteBtn to False
37533>>>>>
37533>>>>>        If (NavigateData.bReadOnly) Begin
37535>>>>>            WebSet pbRender of oEditBtn to True
37536>>>>>        End
37536>>>>>>
37536>>>>>        Else Begin
37537>>>>>            WebSet pbRender of oSaveBtn to True
37538>>>>>            WebSet pbRender of oCancelChangesBtn to True
37539>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37540>>>>>        End
