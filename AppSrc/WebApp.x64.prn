37546>>>>>        WebSet pbRender of oEditBtn to False
37547>>>>>        WebSet pbRender of oSaveBtn to False
37548>>>>>        WebSet pbRender of oCancelChangesBtn to False
37549>>>>>        WebSet pbRender of oDeleteBtn to False
37550>>>>>
37550>>>>>        If (NavigateData.bReadOnly) Begin
37552>>>>>            WebSet pbRender of oEditBtn to True
37553>>>>>        End
37553>>>>>>
37553>>>>>        Else Begin
37554>>>>>            WebSet pbRender of oSaveBtn to True
37555>>>>>            WebSet pbRender of oCancelChangesBtn to True
37556>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37557>>>>>        End
37557>>>>>>
37557>>>>>    End_Procedure
