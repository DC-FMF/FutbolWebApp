37551>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37554>>>>>        Case Begin
37554>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37556>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37556>>>>>                Case Break
37557>>>>>
37557>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37560>>>>>                // If from parent, this is a constrained drill down.
37560>>>>>                Case Break
37561>>>>>
37561>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37564>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37564>>>>>                Case Break
37565>>>>>
37565>>>>>            Case Else // must be nfUndefined
37565>>>>>
37565>>>>>        Case End
37565>>>>>
37565>>>>>        Send SetActionButtons
37566>>>>>
37566>>>>>    End_Procedure
