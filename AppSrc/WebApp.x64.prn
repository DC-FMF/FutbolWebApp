38428>>>>>        WebSet pbRender of oEditBtn to False
38429>>>>>        WebSet pbRender of oSaveBtn to False
38430>>>>>        WebSet pbRender of oCancelChangesBtn to False
38431>>>>>        WebSet pbRender of oDeleteBtn to False
38432>>>>>
38432>>>>>        If (NavigateData.bReadOnly) Begin
38434>>>>>            WebSet pbRender of oEditBtn to True
38435>>>>>        End
38435>>>>>>
38435>>>>>        Else Begin
38436>>>>>            WebSet pbRender of oSaveBtn to True
38437>>>>>            WebSet pbRender of oCancelChangesBtn to True
38438>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38439>>>>>        End
38439>>>>>>
