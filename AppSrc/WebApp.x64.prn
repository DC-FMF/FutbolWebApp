37534>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37537>>>>>        Case Begin
37537>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37539>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37539>>>>>                Case Break
37540>>>>>
37540>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37543>>>>>                // If from parent, this is a constrained drill down.
37543>>>>>                Case Break
37544>>>>>
37544>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37547>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37547>>>>>                Case Break
37548>>>>>
37548>>>>>            Case Else // must be nfUndefined
37548>>>>>
37548>>>>>        Case End
37548>>>>>
37548>>>>>        Send SetActionButtons
